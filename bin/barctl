#!/bin/bash
# barctl — manage which plugins show in the Omarchy bar.
#   barctl list                 JSON for the UI
#   barctl enable|disable <id>  turn a plugin on/off (disable also takes it off the bar)
#   barctl update <id>|--all    omarchy plugin update
#   barctl uninstall <id>       omarchy plugin remove
#   barctl hide <id>            take off the bar, keep installed + enabled
#   barctl show <id>            put back on the bar (same spot it was hidden from)
#   barctl place <id> <top|bottom|left|right> [left|center|right]
#                               move a widget to any bar (extra bars live in extra-bars.json)
#   barctl fix                  drop duplicate tray entries
set -euo pipefail

CFG="${OMARCHY_SHELL_JSON:-$HOME/.config/omarchy/shell.json}"
EXTRA="${OMARCHY_EXTRA_BARS_JSON:-$HOME/.config/omarchy/extra-bars.json}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/barctl-hidden.json"

backup() { cp -f "$CFG" "$CFG.bak.barctl-$(date +%s)"; ls -t "$CFG".bak.barctl-* 2>/dev/null | tail -n +6 | xargs -r rm -f; }

# jq: collapse repeated tray wrappers / order tokens (the cause of doubled icons).
DEDUPE='
  def uniq_by_key(f): reduce .[] as $x ([]; if any(.[]; f == ($x | f)) then . else . + [$x] end);
  def uniq_tokens: reduce .[] as $x ([]; if index($x) != null then . else . + [$x] end);
  .bar.layout |= with_entries(.value |= map(
    if .widgets then .widgets |= uniq_by_key(.entry.id) else . end
    | if .order then .order |= uniq_tokens else . end))'

apply() {  # apply <jq filter> [jq args...]
  local filter="$1"; shift
  local tmp; tmp=$(mktemp)
  jq "$@" "$filter | $DEDUPE" "$CFG" >"$tmp"
  backup
  mv "$tmp" "$CFG"
}

state_get() { [[ -f $STATE ]] && jq -c --arg id "$1" '.[$id] // empty' "$STATE" || true; }
state_set() { local cur='{}'; [[ -f $STATE ]] && cur=$(cat "$STATE"); jq --arg id "$1" --argjson v "$2" '.[$id]=$v' <<<"$cur" >"$STATE.tmp" && mv "$STATE.tmp" "$STATE"; }
state_del() { [[ -f $STATE ]] && jq --arg id "$1" 'del(.[$id])' "$STATE" >"$STATE.tmp" && mv "$STATE.tmp" "$STATE" || true; }

# ---- extra bars (extra-bars.json) -------------------------------------------
extra_find() {  # extra_find <id> -> {"bar":"bottom","section":"right"} or empty
  [[ -f $EXTRA ]] || return 0
  jq -c --arg id "$1" '[.bars[]? | .position as $p | ("left","center","right") as $s
    | select(((.[$s] // []) | index($id)) != null) | {bar: $p, section: $s}] | first // empty' "$EXTRA"
}
extra_remove() {  # extra_remove <id>
  [[ -f $EXTRA ]] || return 0
  local tmp; tmp=$(mktemp)
  jq --arg id "$1" '.bars |= map(
      if ((.left // []) + (.center // []) + (.right // [])) | index($id) then
        # a bar that this removal leaves empty goes away (empty bars you added on purpose stay)
        (.left, .center, .right) |= (if . then map(select(. != $id)) else . end)
        | if ((.left + .center + .right) | length) == 0 then empty else . end
      else . end)' "$EXTRA" >"$tmp" && mv "$tmp" "$EXTRA"
}
extra_add() {  # extra_add <id> <position> <section>
  local tmp; tmp=$(mktemp); [[ -f $EXTRA ]] || echo '{"bars":[]}' >"$EXTRA"
  jq --arg id "$1" --arg p "$2" --arg s "$3" '
      .bars = (.bars // [])
      | (if any(.bars[]; .position == $p) then . else .bars += [{position: $p, left: [], center: [], right: []}] end)
      | .bars |= map(if .position == $p then .[$s] = (((.[$s] // []) | map(select(. != $id))) + [$id]) else . end)' "$EXTRA" >"$tmp" && mv "$tmp" "$EXTRA"
}
needs_service() {  # service+widget plugins must sit directly on a bar, never inside the tray
  omarchy-plugin-catalog | jq -e --arg id "$1" 'any(.[]; .id == $id and ((.kinds // []) | index("service")))' >/dev/null
}
layout_strip() {  # layout_strip <id>: take it off the main bar and out of every tray (enabling a plugin puts it there by default)
  apply '
    .bar.layout |= with_entries(.value |= (
      map(select(.id != $id))
      | map(if .widgets then
              .widgets |= map(select(.entry.id != $id))
              | (if .order then .order |= map(select(. != $id)) else . end)
            else . end)))' --arg id "$1"
}

layout_add() {  # layout_add <id> <section>  (top bar)
  apply '
    (if (.plugins // [] | any((.id? // .) == $id)) then . else .plugins = ((.plugins // []) + [{id: $id}]) end)
    | .bar.layout[$s] = (((.bar.layout[$s] // []) | map(select(.id != $id))) + [{id: $id}])' --arg id "$1" --arg s "$2"
}

on_bar() {  # on_bar <id> -> 0 if on bar (top-level or tray-hosted)
  jq -e --arg id "$1" '[.bar.layout[][] | ., (.widgets? // [] | .[] | .entry)] | any(.id == $id)' "$CFG" >/dev/null && return 0
  [[ -n $(extra_find "$1") ]]
}

cmd_hide() {
  local id="$1" where
  where=$(jq -c --arg id "$1" '
    .bar.layout as $l
    | ([$l | to_entries[] | .key as $s | .value | to_entries[] | select(.value.id == $id) | {section: $s, index: .key}] | first) as $top
    | ([$l[][] | select(.widgets) | select(any(.widgets[]; .entry.id == $id)) | .id] | first) as $tray
    | if $tray then {tray: $tray} elif $top then $top else null end' "$CFG")
  if [[ $where == null ]]; then
    where=$(extra_find "$id"); [[ -n $where ]] || { echo "$id is not on the bar"; return 0; }
  fi
  state_set "$id" "$where"
  extra_remove "$id"
  apply '
    .bar.layout |= with_entries(.value |= (
      map(select(.id != $id))
      | map(if .widgets then
              .widgets |= map(select(.entry.id != $id))
              | (if .order then .order |= map(select(. != $id)) else . end)
            else . end)))' --arg id "$id"
  echo "Removed $id from bar (still installed)"
}

cmd_show() {
  local id="$1" where tray
  if on_bar "$id"; then echo "$id is already on the bar"; return 0; fi
  where=$(state_get "$id")
  tray=$(jq -r '.tray // empty' <<<"${where:-{\}}")
  local xbar; xbar=$(jq -r '.bar // empty' <<<"${where:-{\}}")
  if [[ -n $xbar ]]; then
    omarchy-shell shell setPluginEnabled "$id" true >/dev/null
    layout_strip "$id"
    extra_add "$id" "$xbar" "$(jq -r '.section' <<<"$where")"
  elif [[ -n $tray ]] && needs_service "$id"; then
    omarchy-shell shell setPluginEnabled "$id" true >/dev/null
    layout_add "$id" right
  elif [[ -n $tray ]]; then
    apply '
      (if (.plugins // [] | any((.id? // .) == $id)) then . else .plugins = ((.plugins // []) + [{id: $id}]) end)
      | .bar.layout |= with_entries(.value |= map(
          if .id == $tray then .widgets = ((.widgets // []) + [{entry: {id: $id}}]) else . end))' \
      --arg id "$id" --arg tray "$tray"
  else
    local sect; sect=$(jq -r '.section // empty' <<<"${where:-{\}}")
    omarchy-shell shell setPluginEnabled "$id" true >/dev/null
    layout_add "$id" "${sect:-right}"
  fi
  state_del "$id"
  echo "Added $id to bar"
}

extra_has() { [[ -f $EXTRA ]] && jq -e --arg p "$1" 'any(.bars[]?; .position == $p)' "$EXTRA" >/dev/null; }
main_pos() { jq -r '.bar.position // "top"' "$CFG"; }

BARS_SAVED="${XDG_STATE_HOME:-$HOME/.local/state}/barctl-removed-bars.json"

cmd_togglebar() {  # add an extra bar on an edge, or remove it. A removed bar's widgets are remembered and come back when the bar is re-added.
  local pos="$1" tmp saved; tmp=$(mktemp)
  case "$pos" in top|bottom|left|right) ;; *) echo "bar must be top, bottom, left or right" >&2; exit 1 ;; esac
  [[ $pos != "$(main_pos)" ]] || { echo "$pos is the main bar"; return 0; }
  [[ -f $EXTRA ]] || echo '{"bars":[]}' >"$EXTRA"
  mkdir -p "$(dirname "$BARS_SAVED")"; [[ -f $BARS_SAVED ]] || echo '{}' >"$BARS_SAVED"
  if extra_has "$pos"; then
    # remember its widgets (only if there are any), then drop the bar
    jq --arg p "$pos" --slurpfile x "$EXTRA" '
      ($x[0].bars[]? | select(.position == $p)) as $b
      | if (($b.left + $b.center + $b.right) | length) > 0 then .[$p] = ($b | del(.position)) else . end' "$BARS_SAVED" >"$tmp" && mv "$tmp" "$BARS_SAVED"
    tmp=$(mktemp)
    jq --arg p "$pos" '.bars |= map(select(.position != $p))' "$EXTRA" >"$tmp" && mv "$tmp" "$EXTRA"
    echo "Removed the $pos bar (its widgets are remembered)"
  else
    saved=$(jq -c --arg p "$pos" '.[$p] // empty' "$BARS_SAVED")
    jq --arg p "$pos" --argjson s "${saved:-null}" '
      .bars = ((.bars // []) + [ {position: $p, left: [], center: [], right: []} + ($s // {}) ])' "$EXTRA" >"$tmp" && mv "$tmp" "$EXTRA"
    if [[ -n $saved ]]; then
      tmp=$(mktemp); jq --arg p "$pos" 'del(.[$p])' "$BARS_SAVED" >"$tmp" && mv "$tmp" "$BARS_SAVED"
      echo "Added a $pos bar with its remembered widgets"
    else
      echo "Added a $pos bar"
    fi
  fi
}

cmd_mainpos() {  # move the main bar to an edge; a bar already there swaps to the main bar's old edge (nobody loses widgets)
  local pos="$1" old tmp; old=$(main_pos); tmp=$(mktemp)
  [[ $pos != "$old" ]] || return 0
  if extra_has "$pos"; then
    jq --arg p "$pos" --arg o "$old" '.bars |= map(if .position == $p then .position = $o else . end)' "$EXTRA" >"$tmp" && mv "$tmp" "$EXTRA"
  fi
  omarchy-bar position "$pos"
}

cmd_swapbars() {  # swap any two bars (main or extra) by their edges: barctl swapbars <edge> <edge>
  local a="$1" b="$2" tmp; tmp=$(mktemp)
  for e in "$a" "$b"; do case "$e" in top|bottom|left|right) ;; *) echo "edges must be top, bottom, left or right" >&2; exit 1 ;; esac; done
  [[ $a != "$b" ]] || return 0
  local main; main=$(main_pos)
  if [[ $a == "$main" ]]; then cmd_mainpos "$b"; return; fi
  if [[ $b == "$main" ]]; then cmd_mainpos "$a"; return; fi
  extra_has "$a" || extra_has "$b" || { echo "neither edge has a bar"; return 0; }
  jq --arg a "$a" --arg b "$b" '.bars |= map(if .position == $a then .position = $b elif .position == $b then .position = $a else . end)' "$EXTRA" >"$tmp" && mv "$tmp" "$EXTRA"
  echo "Swapped the $a and $b bars"
}

cmd_place() {  # cmd_place <id> <top|bottom|left|right> [section]
  local id="$1" pos="${2:-}" sect="${3:-right}"
  case "$pos" in top|bottom|left|right) ;; *) echo "bar must be top, bottom, left or right" >&2; exit 1 ;; esac
  case "$sect" in left|center|right) ;; *) echo "section must be left, center or right" >&2; exit 1 ;; esac
  # enabling puts a plugin on the main bar by default, so enable first, then take it off everywhere and add it where asked
  omarchy-shell shell setPluginEnabled "$id" true >/dev/null
  layout_strip "$id"
  extra_remove "$id"
  if [[ $pos == top ]]; then layout_add "$id" "$sect"; else extra_add "$id" "$pos" "$sect"; fi
  state_del "$id"
  echo "Moved $id to $pos bar ($sect)"
}

cmd_list() {
  local cat; cat=$(omarchy-plugin-catalog)
  omarchy plugin list --json | jq --argjson cat "$cat" --slurpfile c "$CFG" --slurpfile x <([[ -f $EXTRA ]] && cat "$EXTRA" || echo '{"bars":[]}') '
    ($c[0].bar.layout // {}) as $l
    | [ $l | to_entries[] | .key as $s | .value[] | {id, section: $s} ] as $top
    | [ $l | to_entries[] | .value[] | .widgets? // [] | .[] | {id: .entry.id, section: "tray"} ] as $tray
    | [ $x[0].bars[]? | .position as $p | ("left","center","right") as $s | (.[$s] // [])[] | {id: ., section: ($p + "/" + $s), bar: $p} ] as $extra
    | ($top + $tray + $extra) as $onbar
    | ($cat | map({key: .id, value: .}) | from_entries) as $meta
    | [ .[] | select(.kinds | index("bar-widget"))
        | . as $x
        | ($onbar | map(select(.id == $x.id)) | first) as $b
        | ($meta[$x.id] // {}) as $m
        | { id, name, firstParty,
            enabled: (.enabled or ($b != null)),
            onBar: ($b != null), section: ($b.section // ""), bar: ($b.bar // (if $b != null then "top" else "" end)),
            needsService: (($m.kinds // []) | index("service") != null),
            canManage: (.firstParty | not),
            description: ($m.description // ""),
            category: ($m.barWidget.category // ""),
            aliases: ($m.barWidget.aliases // []) } ]
    | sort_by(.name | ascii_downcase)'
}

id="${2:-}"
case "${1:-}" in
  list) cmd_list ;;
  fix) apply '.' ; echo "Removed duplicate tray entries" ;;
  enable)
    omarchy-shell shell setPluginEnabled "$id" true >/dev/null
    on_bar "$id" || cmd_show "$id" >/dev/null
    echo "Enabled $id" ;;
  disable)
    cmd_hide "$id" >/dev/null
    omarchy plugin disable "$id" ;;
  update) if [[ $id == --all ]]; then omarchy plugin update --yes; else omarchy plugin update "$id" --yes; fi ;;
  uninstall) cmd_hide "$id" >/dev/null || true; state_del "$id"; omarchy plugin remove "$id" --yes ;;
  hide) cmd_hide "$id" ;;
  togglebar) cmd_togglebar "$id" ;;
  hasbar) extra_has "$id" ;;
  mainpos) cmd_mainpos "$id" ;;
  swapbars) cmd_swapbars "$id" "${3:-}" ;;
  place) cmd_place "$id" "${3:-}" "${4:-right}" ;;
  show) cmd_show "$id" ;;
  *) echo "usage: barctl list|place|enable|disable|update|uninstall|hide|show|fix <id>" >&2; exit 1 ;;
esac
