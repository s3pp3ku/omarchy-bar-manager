#!/usr/bin/env python3
"""Multi-bar layout history, persistence and reviewed plugin updates."""
import contextlib
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import time
import urllib.parse
import uuid
import tray_layout

HOME = Path.home()
CFG = Path(os.environ.get('OMARCHY_SHELL_JSON', HOME / '.config/omarchy/shell.json'))
EXTRA = Path(os.environ.get('OMARCHY_EXTRA_BARS_JSON', HOME / '.config/omarchy/extra-bars.json'))
STATE = Path(os.environ.get('XDG_STATE_HOME', HOME / '.local/state'))
DATA = STATE / 'bar-manager'
PLUGINS = Path(os.environ.get('BARCTL_PLUGINS_DIR', HOME / '.config/omarchy/plugins'))
CORE = Path(__file__).with_name('barctl-core')
MEMORIES = ['barctl-hidden.json', 'barctl-removed-main-entries.json', 'barctl-removed-bars.json', 'barctl-private-tray-hidden.json']
BAR_KEYS = ['layout', 'position', 'transparent', 'centerAnchor']
MUTATIONS = {'place', 'drop', 'toggle', 'setsection', 'hide', 'show', 'enable', 'disable', 'fix', 'togglebar', 'mainpos', 'swapbars', 'addtray', 'rmtray', 'intray', 'reorder', 'move-section'}


def read(path, default=None):
    return json.loads(path.read_text()) if path.exists() else default


def write(path, obj):
    # Follow dotfile symlinks and preserve the target's permissions.
    path = path.resolve()
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    try:
        os.fchmod(fd, path.stat().st_mode & 0o777 if path.exists() else 0o600)
        with os.fdopen(fd, 'w') as stream:
            json.dump(obj, stream, indent=2)
            stream.write('\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def run(argv, **kwargs):
    p = subprocess.run([str(a) for a in argv], capture_output=True, text=True, **kwargs)
    if p.returncode:
        raise RuntimeError((p.stderr or p.stdout).strip() or f'{argv[0]} failed ({p.returncode})')
    return p.stdout.strip()


def catalog():
    return json.loads(run(['omarchy-plugin-catalog']))


def snapshot():
    cfg = read(CFG, {})
    ids = [p['id'] for p in catalog() if 'bar-widget' in p.get('kinds', [])]
    return {'schema': 1, 'bar': {k: cfg.get('bar', {}).get(k) for k in BAR_KEYS},
            'extra': read(EXTRA, {'bars': []}), 'widgetIds': ids,
            'plugins': [p for p in cfg.get('plugins', []) if (p.get('id') if isinstance(p, dict) else p) in ids],
            'disabled': [p for p in cfg.get('disabledPlugins', []) if p in ids],
            'memory': {name: read(STATE / name, {}) for name in MEMORIES}}


def save_record(folder, name, value):
    ident = uuid.uuid4().hex
    write(DATA / folder / (ident + '.json'), {'id': ident, 'name': name, 'time': time.time(), 'layout': value})
    return ident


def records(folder):
    directory = DATA / folder
    return sorted([read(p) for p in directory.glob('*.json')], key=lambda r: r['time'], reverse=True)


def checkpoint(label, value):
    ident = save_record('history', label, value)
    for entry in records('history')[30:]:
        (DATA / 'history' / (entry['id'] + '.json')).unlink()
    return ident


def entry_id(e):
    return e.get('id', '') if isinstance(e, dict) else e


def widget_settings(ident, edge, payload):
    """Persist a hosted widget's inline options without moving its button."""
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', ident) or '..' in ident:
        raise RuntimeError('Invalid widget ID')
    if edge not in ('top', 'bottom', 'left', 'right'):
        raise RuntimeError('Invalid bar edge')
    settings = json.loads(payload)
    if not isinstance(settings, dict):
        raise RuntimeError('Widget settings must be an object')
    # Patch only options, never let a payload replace the widget or its tray.
    settings = {k: v for k, v in settings.items() if k not in ('id', 'widgets')}
    cfg, extra = read(CFG, {}), read(EXTRA, {'bars': []})
    remembered = read(STATE / 'barctl-removed-main-entries.json', {})
    try:
        tray_layout.save_settings(cfg, extra, ident, edge, settings, remembered)
    except ValueError as error:
        raise RuntimeError(str(error)) from error
    if cfg != read(CFG, {}):
        write(CFG, cfg)
    if extra != read(EXTRA, {'bars': []}):
        write(EXTRA, extra)
    return 'Saved widget settings'


def tray_action(args):
    cfg, extra = read(CFG, {}), read(EXTRA, {'bars': []})
    cmd = args[0]
    if cmd == 'fork-tray':
        tray_layout.migrate(cfg, extra)
    elif cmd == 'tray-capture' or cmd == 'intray':
        if cmd == 'intray':
            ident, edge = args[1], args[3] if len(args) > 3 else cfg['bar'].get('position', 'top')
            order, source = None, args[4] if len(args) > 4 else ''
        else:
            ident, edge = args[2:4]
            order = json.loads(args[4]) if len(args) > 4 else None
            source = args[5] if len(args) > 5 else ''
        manifest = next((p for p in catalog() if p['id'] == ident), None)
        if manifest and 'service' in manifest.get('kinds', []) and not native_host_ready():
            raise RuntimeError('This widget needs a companion service. Keep it directly on any bar; capturing it inside the Tray is not supported safely yet.')
        tray_layout.capture(cfg, extra, ident, edge, order, source)
    elif cmd == 'tray-release':
        tray_layout.release(cfg, extra, args[2], args[3], args[4] if len(args) > 4 else 'right', args[5] if len(args) > 5 else '')
    elif cmd in ('place', 'drop'):
        tray_layout.move(cfg, extra, args[2], args[3] if len(args) > 3 else 'right', args[4] if len(args) > 4 else '', args[5] if len(args) > 5 else '')
    elif cmd == 'toggle':
        memory_path = STATE / 'barctl-private-tray-hidden.json'
        memory = read(memory_path, {})
        edge = args[2]
        removed = tray_layout.toggle(cfg, extra, edge, args[3] if len(args) > 3 else 'right', memory.get(edge))
        if removed:
            memory[edge] = removed
        else:
            memory.pop(edge, None)
        write(memory_path, memory)
    else:
        raise RuntimeError('Unsupported private Tray action')
    # Keep component references alive before rebuilding any extra-bar widgets.
    if cfg != read(CFG, {}):
        write(CFG, cfg)
    if extra != read(EXTRA, {'bars': []}):
        write(EXTRA, extra)
    return 'Updated your four-edge Tray'


def native_host_ready():
    ipc = HOME / '.config/omarchy/native-bars/bin/omarchy-shell'
    flag = ipc.parent.parent / 'enabled'
    if not flag.is_file() or not ipc.is_file():
        return False
    try:
        status = json.loads(run([ipc, 'shell', 'nativeBarStatus'], timeout=4))
        return status.get('version') == 1 and status.get('renderer') == 'native'
    except (RuntimeError, ValueError, subprocess.TimeoutExpired):
        return False


def native_drop(args):
    cfg, extra = read(CFG, {}), read(EXTRA, {'bars': []})
    tray_layout.move_widget(cfg, extra, args[1], args[2], args[3], args[4], args[5])
    if cfg != read(CFG, {}):
        write(CFG, cfg)
    if extra != read(EXTRA, {'bars': []}):
        write(EXTRA, extra)
    return 'Moved native bar widget'


def native_drawer_action(args):
    cfg, extra = read(CFG, {}), read(EXTRA, {'bars': []})
    cmd = args[0]
    if cmd == 'addtray':
        edge = args[1]
        if edge == 'auto':
            edge = next((b['position'] for b in extra['bars']), 'bottom' if cfg['bar'].get('position','top') != 'bottom' else 'top')
        ident = tray_layout.add_drawer(cfg, extra, edge, args[2] if len(args) > 2 else 'right')
        output = 'Added ' + ident
    elif cmd == 'rmtray':
        tray_layout.remove_drawer(cfg, extra, args[1], args[2] if len(args) > 2 else '')
        output = 'Removed drawer; its widgets stay on their bar'
    else:
        tray_layout.capture_drawer(cfg, extra, args[1], args[2], args[3] if len(args) > 3 else '', args[4] if len(args) > 4 else '')
        output = 'Put widget in native drawer'
    if cfg != read(CFG, {}):
        write(CFG, cfg)
    if extra != read(EXTRA, {'bars': []}):
        write(EXTRA, extra)
    return output


def apply_snapshot(s):
    if s.get('schema') != 1 or not isinstance(s.get('extra', {}).get('bars'), list):
        raise RuntimeError('Unsupported or invalid layout snapshot')
    cfg = read(CFG, {})
    available = {p['id'] for p in catalog()}
    skipped = set()

    def entries(values):
        result = []
        for e in values or []:
            ident = entry_id(e)
            if ident.startswith('tray:') or ident in available:
                if isinstance(e, dict) and 'widgets' in e:
                    e = dict(e)
                    e['widgets'] = [w for w in e['widgets'] if entry_id(w.get('entry', w) if isinstance(w, dict) else w) in available]
                result.append(e)
            else:
                skipped.add(ident)
        return result

    bar = cfg.setdefault('bar', {})
    for key, value in s['bar'].items():
        if value is None:
            bar.pop(key, None)
        elif key == 'layout':
            bar[key] = {section: entries(value.get(section, [])) for section in ('left', 'center', 'right')}
        else:
            bar[key] = value
    # Keep the manager reachable, using its current full entry when possible.
    manager = 's3pp3ku.bar-manager'
    if manager not in [entry_id(e) for lane in bar.get('layout', {}).values() for e in lane]:
        bar.setdefault('layout', {}).setdefault('right', []).append({'id': manager})
    widget_ids = set(s['widgetIds'])
    cfg['plugins'] = [p for p in cfg.get('plugins', []) if entry_id(p) not in widget_ids] + [p for p in s['plugins'] if entry_id(p) in available]
    cfg['disabledPlugins'] = [p for p in cfg.get('disabledPlugins', []) if p not in widget_ids] + [p for p in s['disabled'] if p in available and p != manager]
    extra = json.loads(json.dumps(s['extra']))
    for b in extra['bars']:
        for section in ('left', 'center', 'right'):
            b[section] = entries(b.get(section, []))
    # Older snapshots may have side-bar buttons without enabled plugin
    # references. Extra Bars can draw them, but the shell refuses to load
    # their overlays/services unless their ids also appear in shell.json.
    enabled_ids = {entry_id(p) for p in cfg['plugins']}
    for b in extra['bars']:
        for section in ('left', 'center', 'right'):
            for e in b[section]:
                hosted = [e] + e.get('widgets', []) if isinstance(e, dict) else [e]
                for widget in hosted:
                    ident = entry_id(widget.get('entry', widget) if isinstance(widget, dict) else widget)
                    if ident in available and ident not in enabled_ids:
                        cfg['plugins'].append({'id': ident})
                        enabled_ids.add(ident)
    # Validate all data before writing either configuration.
    write(CFG, cfg)
    write(EXTRA, extra)
    for name in MEMORIES:
        write(STATE / name, s['memory'].get(name, {}))
    return skipped


def core(args):
    if args[0] == 'native-drop':
        return native_drop(args)
    if args[0] in ('drop', 'place') and len(args) > 5 and args[5] and native_host_ready():
        return native_drop(['native-drop'] + args[1:6])
    if ((args[0] in ('addtray', 'rmtray')) or (args[0] == 'intray' and len(args) > 2 and args[2].startswith('tray:'))) and native_host_ready():
        return native_drawer_action(args)
    if (args[0] in ('fork-tray', 'tray-capture', 'tray-release')
            or (len(args) > 1 and args[1] == tray_layout.TRAY and args[0] in ('drop', 'place', 'toggle'))
            or (args[0] == 'intray' and len(args) > 2 and args[2] == tray_layout.TRAY)):
        return tray_action(args)
    p = subprocess.run([str(CORE)] + args, capture_output=True, text=True)
    if p.returncode:
        raise RuntimeError((p.stderr or p.stdout).strip() or 'Bar action failed')
    output = p.stdout.strip()
    if output in ('unknown', 'false', 'unknown plugin') or 'Function not found' in output or 'Target not found' in output:
        raise RuntimeError(output)
    if args[0] == 'layout':
        layout = json.loads(output)
        layout['nativeHost'] = native_host_ready()
        return json.dumps(layout)
    return output


def reorder(ident, edge, section, direction, tray=""):
    def sequence(container):
        seq = container[section]
        if tray:
            seq = next(e for e in seq if entry_id(e) == tray)["widgets"]
        return seq
    cfg = read(CFG, {})
    main = cfg.get('bar', {}).get('position', 'top')
    if edge == main:
        seq = sequence(cfg['bar']['layout'])
    else:
        extra = read(EXTRA, {'bars': []})
        seq = sequence(next(b for b in extra['bars'] if b['position'] == edge))
    i = next(i for i, e in enumerate(seq) if entry_id(e.get('entry', e) if isinstance(e, dict) else e) == ident)
    j = max(0, min(len(seq) - 1, i + int(direction)))
    if i == j:
        return 'Already at the end of this section'
    seq[i], seq[j] = seq[j], seq[i]
    write(CFG if edge == main else EXTRA, cfg if edge == main else extra)
    return f'Reordered {ident} on {edge}'


def move_section(ident, edge, section):
    if section not in ('left', 'center', 'right'):
        raise RuntimeError('Invalid section')
    cfg = read(CFG, {})
    main = cfg.get('bar', {}).get('position', 'top')
    extra = read(EXTRA, {'bars': []})
    container = cfg['bar']['layout'] if edge == main else next(b for b in extra['bars'] if b['position'] == edge)
    found = None
    for lane in ('left', 'center', 'right'):
        for e in list(container.get(lane, [])):
            if entry_id(e) == ident:
                found = e
                container[lane].remove(e)
    if found is None:
        raise RuntimeError('Select a widget directly on a bar to change its section')
    container.setdefault(section, []).append(found)
    write(CFG if edge == main else EXTRA, cfg if edge == main else extra)
    return f'Moved {ident} to {edge}/{section}'


def git(directory, *args):
    env = dict(os.environ, GIT_TERMINAL_PROMPT='0', GIT_ALLOW_PROTOCOL='https:ssh:git:file', GIT_SSH_COMMAND='ssh -oBatchMode=yes')
    return run(['git', '-c', 'core.fsmonitor=', '-c', 'core.hooksPath=/dev/null', '-C', directory, *args], env=env, timeout=45)


def eligible(directory):
    if directory.is_symlink():
        raise RuntimeError('Linked plugin; skipped')
    if not (directory / '.git').exists():
        raise RuntimeError('Not a Git installation')
    if git(directory, 'status', '--porcelain'):
        raise RuntimeError('Local changes; skipped to preserve your edits')


def check_updates(only):
    reports = []
    candidates = [PLUGINS / only] if only != '--all' else sorted(PLUGINS.iterdir())
    for directory in candidates:
        if not directory.is_dir() or directory.name.startswith('.'):
            continue
        if only == '--all' and not (directory / '.git').exists():
            continue
        report = {'id': directory.name, 'status': 'skipped', 'summary': '', 'token': ''}
        try:
            eligible(directory)
            old = git(directory, 'rev-parse', 'HEAD')
            branch = git(directory, 'symbolic-ref', '--quiet', '--short', 'HEAD')
            remote = git(directory, 'config', f'branch.{branch}.remote')
            ref = git(directory, 'config', f'branch.{branch}.merge')
            git(directory, 'fetch', '--quiet', '--no-recurse-submodules', remote, ref)
            target = git(directory, 'rev-parse', 'FETCH_HEAD')
            if old == target:
                report.update(status='current', summary='Up to date')
            else:
                try:
                    git(directory, 'merge-base', '--is-ancestor', old, target)
                except RuntimeError:
                    raise RuntimeError('Local and remote histories differ; skipped')
                count = git(directory, 'rev-list', '--count', old + '..' + target)
                summary = git(directory, 'log', '-12', '--format=%h %s', old + '..' + target)
                stat = git(directory, 'diff', '--shortstat', old, target)
                token = uuid.uuid4().hex
                write(DATA / 'updates' / (token + '.json'), {'id': directory.name, 'old': old, 'target': target})
                report.update(status='available', summary=f'{count} new commits\n{summary}\n{stat}', token=token, commit=target[:10])
        except (RuntimeError, subprocess.TimeoutExpired) as e:
            report['summary'] = str(e) or 'Update check failed'
        reports.append(report)
    return reports


def update_apply(token, rescan=True):
    if not re.fullmatch('[a-f0-9]{32}', token):
        raise RuntimeError('Invalid update preview')
    plan = read(DATA / 'updates' / (token + '.json'))
    if not plan:
        raise RuntimeError('Update preview has expired; check again')
    directory = PLUGINS / plan['id']
    eligible(directory)
    if git(directory, 'rev-parse', 'HEAD') != plan['old']:
        raise RuntimeError('Plugin changed since preview; check again')
    git(directory, 'merge', '--ff-only', '--quiet', plan['target'])
    try:
        run(['omarchy-plugin-validate', directory])
    except RuntimeError:
        git(directory, 'reset', '--hard', plan['old'])
        raise RuntimeError('Update failed validation and was rolled back')
    (DATA / 'updates' / (token + '.json')).unlink()
    if rescan:
        run(['omarchy-shell', 'shell', 'rescanPlugins'])
    return f"Updated {plan['id']} to {plan['target'][:10]}"


def update_apply_all(tokens):
    """Apply several reviewed updates in one run: a failure is reported and the
    rest carry on, Bar Manager's own update goes last (it reloads this panel),
    and the shell rescans once at the end rather than once per plugin."""
    plans = []
    for token in tokens:
        plan = (read(DATA / 'updates' / (token + '.json'), {}) or {}) if re.fullmatch('[a-f0-9]{32}', token) else {}
        plans.append((plan.get('id', ''), token))
    plans.sort(key=lambda p: p[0] == CORE.parent.parent.name)
    results, applied = [], 0
    for ident, token in plans:
        try:
            update_apply(token, rescan=False)
            results.append({'id': ident, 'token': token, 'ok': True, 'message': 'Updated'})
            applied += 1
        except (RuntimeError, OSError, subprocess.TimeoutExpired) as e:
            results.append({'id': ident, 'token': token, 'ok': False, 'message': str(e) or 'Update failed'})
    if applied:
        run(['omarchy-shell', 'shell', 'rescanPlugins'])
    return results


def dispatch(args):
    cmd = args[0]
    if cmd == 'widget-settings':
        return widget_settings(*args[1:4])
    if cmd == 'shortcut':
        result = json.loads(run([sys.executable, str(CORE.parent / 'shortcut.py')] + args[1:]))
        return result.get('message', 'Done')
    if cmd == 'marketplace':
        cache = DATA / 'marketplace.json'
        refresh = '--refresh' in args[1:]

        def fresh(path):
            # A saved copy younger than this is used as is; Refresh catalog always downloads.
            return not refresh and path.is_file() and time.time() - path.stat().st_mtime < 12 * 3600

        try:
            if fresh(cache):
                raise LookupError('use the saved catalog')
            raw = run(['curl', '-fsSL', '--max-time', '30', '--max-filesize', '16777216', 'https://plugins.omarchy.org/catalog.json'])
            document = json.loads(raw)
            if not isinstance(document.get('plugins'), list):
                raise RuntimeError('Invalid marketplace response')
            write(cache, document)
        except Exception:
            document = read(cache, {})
            if not document.get('plugins'):
                raise RuntimeError('Could not load the marketplace catalog')
        # Read-only popularity counts the marketplace site shows (views, install-command copies, hearts). Optional.
        stats_cache = DATA / 'marketplace-stats.json'
        try:
            if fresh(stats_cache):
                raise LookupError('use the saved counts')
            stats = json.loads(run(['curl', '-fsSL', '--max-time', '15', '--max-filesize', '4194304',
                                    '-H', 'Accept: application/json', 'https://api.omarchyplugins.com/v1/stats']))
            if not isinstance(stats.get('plugins'), dict):
                raise RuntimeError('Invalid stats response')
            write(stats_cache, stats)
        except Exception:
            stats = read(stats_cache, {})
        counts = stats.get('plugins') if isinstance(stats.get('plugins'), dict) else {}

        def count(value):
            return value if isinstance(value, int) and value >= 0 else 0

        listings = []
        for entry in document['plugins']:
            if not isinstance(entry, dict): continue
            url = entry.get('repo', '')
            if not isinstance(url, str) or not url.startswith('https://'): continue
            listing = {key: str(entry.get(key, ''))[:4000] for key in ('id','name','description','author','version','category','license','verificationStatus','verificationCoverage','installNote','previewImage','kind')}
            listing.update(repo=url, installAvailable=entry.get('installAvailable') is True,
                           installed=(PLUGINS / listing['id'] / 'manifest.json').is_file())
            stars = entry.get('stars')
            listing['stars'] = stars if isinstance(stars, int) and stars >= 0 else 0
            for key, source in (('addedAt', entry.get('listedAt') or entry.get('addedAt')), ('updatedAt', entry.get('repositoryUpdatedAt'))):
                listing[key] = source[:10] if isinstance(source, str) and re.match(r'\d{4}-\d{2}-\d{2}', source) else ''
            thumb = entry.get('previewThumbnail')
            listing['thumbnail'] = 'https://plugins.omarchy.org/' + thumb if isinstance(thumb, str) and thumb.startswith('assets/') else ''
            initials = entry.get('initials')
            listing['initials'] = initials[:3] if isinstance(initials, str) else listing['name'][:2].upper()
            listing['webPage'] = 'https://plugins.omarchy.org/plugin.html?id=' + urllib.parse.quote(listing['id'], safe='')
            plugin_counts = counts.get(listing['id']) if isinstance(counts.get(listing['id']), dict) else {}
            listing['installs'] = count(plugin_counts.get('copies'))
            listing['views'] = count(plugin_counts.get('views'))
            listing['hearts'] = count(plugin_counts.get('hearts'))
            image = listing['previewImage']
            listing['previewImage'] = 'https://plugins.omarchy.org/' + image if image.startswith('assets/') else ''
            listings.append(listing)
        return json.dumps(sorted(listings, key=lambda e: e['name'].lower()))
    if cmd == 'market-install':
        ident, edge, section = args[1:4]
        if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', ident) or '..' in ident:
            raise RuntimeError('Invalid plugin ID')
        if edge not in ('top','bottom','left','right') or section not in ('left','center','right'):
            raise RuntimeError('Choose a valid bar and section')
        document = read(DATA / 'marketplace.json', {})
        matches = [e for e in document.get('plugins', []) if e.get('id') == ident]
        if len(matches) != 1 or matches[0].get('installAvailable') is not True:
            raise RuntimeError('This listing requires manual installation')
        if (PLUGINS / ident).exists(): raise RuntimeError('Plugin is already installed')
        url = matches[0].get('repo', '')
        if not url.startswith('https://github.com/') or not re.fullmatch(r'https://github.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?', url):
            raise RuntimeError('Unsupported repository URL; use the Git URL installer')
        checkpoint('Install ' + ident, snapshot())
        output = run(['omarchy', 'plugin', 'add', url, '--enable', '--yes'])
        if not (PLUGINS / ident / 'manifest.json').is_file():
            raise RuntimeError('Installed repository uses a different plugin ID. Refresh to place it.')
        manifest = read(PLUGINS / ident / 'manifest.json', {})
        kinds = manifest.get('kinds', [])
        name = manifest.get('name') or ident
        if 'bar-widget' in kinds:
            core(['place', ident, edge, section])
            return output + f'\nInstalled {name} on the {edge} bar ({section})'
        kind = 'a panel' if 'panel' in kinds else 'a background service' if 'service' in kinds else 'not a bar widget'
        return output + f'\nInstalled {name}. It is {kind}, so it does not go on a bar: open it from SUPER+SPACE or give it a shortcut in Keys'
    if cmd == 'ui-get':
        return json.dumps(read(DATA / 'ui.json', {}))
    if cmd == 'ui-save':
        write(DATA / 'ui.json', json.loads(args[1])); return ''
    if cmd == 'snapshots':
        return json.dumps([{k: v for k, v in r.items() if k != 'layout'} | {'kind': folder} for folder in ('saved', 'history') for r in records(folder)])
    if cmd == 'save-layout':
        name = args[1].strip() if len(args) > 1 else 'My layout'
        if not name:
            raise RuntimeError('Enter a name for this layout')
        save_record('saved', name[:120], snapshot()); return 'Saved layout: ' + name
    if cmd in ('restore-layout', 'undo'):
        if cmd == 'undo':
            history = records('history')
            if not history:
                raise RuntimeError('Nothing to undo')
            record = history[0]
            apply_snapshot(record['layout'])
            (DATA / 'history' / (record['id'] + '.json')).unlink()
            return 'Undid: ' + record['name']
        folder, ident = args[1:3]
        if folder not in ('history', 'saved') or not re.fullmatch('[a-f0-9]{32}', ident):
            raise RuntimeError('Invalid layout selection')
        record = read(DATA / folder / (ident + '.json'))
        if not record:
            raise RuntimeError('Layout no longer exists')
        checkpoint('Restore ' + record['name'], snapshot())
        missing = apply_snapshot(record['layout'])
        return 'Restored ' + record['name'] + (f'; skipped {len(missing)} uninstalled plugins' if missing else '')
    if cmd == 'check-updates':
        only = args[1] if len(args) > 1 else '--all'
        if only != '--all' and not re.fullmatch('[A-Za-z0-9][A-Za-z0-9._-]*', only):
            raise RuntimeError('Invalid plugin id')
        return json.dumps(check_updates(only))
    if cmd == 'apply-update':
        return update_apply(args[1])
    if cmd == 'apply-updates':
        return json.dumps(update_apply_all(args[1:]))
    if cmd == 'add-plugin':
        url = args[1].strip()
        if not url.startswith(('https://', 'ssh://', 'git@')):
            raise RuntimeError('Enter an HTTPS or SSH Git URL')
        checkpoint('Install plugin', snapshot())
        return run(['omarchy', 'plugin', 'add', url, '--enable', '--yes'])
    if cmd == 'update':
        raise RuntimeError('Use check-updates, review the preview, then apply-update <token>')
    if cmd in MUTATIONS or cmd in ('fork-tray', 'tray-capture', 'tray-release', 'native-drop'):
        before = snapshot()
        history_id = checkpoint(' '.join(args), before)
        try:
            output = reorder(*args[1:]) if cmd == 'reorder' else move_section(*args[1:]) if cmd == 'move-section' else core(args)
        except Exception:
            if snapshot() == before:
                (DATA / 'history' / (history_id + '.json')).unlink()
            raise
        after = snapshot()
        if after == before:
            (DATA / 'history' / (history_id + '.json')).unlink()
        return output
    return core(args)


if __name__ == '__main__':
    try:
        DATA.mkdir(parents=True, exist_ok=True)
        with (DATA / 'lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            print(dispatch(sys.argv[1:]))
    except Exception as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
